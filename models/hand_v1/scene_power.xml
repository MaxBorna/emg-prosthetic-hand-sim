<!-- Power grasp scene: a horizontal cylinder (like a bottle) in front of the palm. -->
<mujoco model="hand_v1_power">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" cone="elliptic" impratio="10"/>
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.25 0.3" rgb2="0.3 0.35 0.4" width="256" height="256"/>
    <material name="grid" texture="grid" texrepeat="8 8"/>
  </asset>
  <include file="hand.xml"/>
  <worldbody>
    <light pos="0 -0.5 1" dir="0 0.5 -1"/>
    <geom name="floor" type="plane" size="1 1 0.05" material="grid"/>
    <geom name="pedestal" type="box" pos="0 0.032 0.075" size="0.012 0.008 0.075" rgba="0.5 0.5 0.5 1"/>
    <body name="object" pos="0 0.032 0.17">
      <freejoint name="object"/>
      <geom name="object" type="cylinder" size="0.02 0.05" euler="0 1.5708 0" rgba="0.2 0.6 0.9 1" mass="0.15" friction="1.5 0.02 0.001" condim="4"/>
    </body>
  </worldbody>
</mujoco>
